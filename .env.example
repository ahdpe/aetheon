# AETHEON Configuration
PORT=3000
HOST=0.0.0.0

# AI Xenobiologist (Venice AI / Jev / OpenAI compatible endpoint)
# If left empty, Aetheon uses its built-in procedural naturalist engine (zero cost, works offline)
VENICE_API_KEY=
VENICE_API_URL=https://api.venice.ai/api/v1/chat/completions
VENICE_MODEL=llama-3.3-70b
AI_OBSERVER_INTERVAL_MIN=25

# Simulation Tuning
TICK_RATE_HZ=10
GRID_SIZE=128
MAX_ORGANISMS=1000
PERSIST_INTERVAL_MIN=10
SNAPSHOT_FILE=./data/aetheon_world.json
